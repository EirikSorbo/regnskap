rules_version = '2';

// ============================================================================
//  Firestore-sikkerhetsregler — regnskapsappen
// ----------------------------------------------------------------------------
//  Hver bruker eier kun SINE egne oppføringer. All lesing/skriving krever
//  innlogging, og en bruker kan bare røre dokumenter der userId (eller dok-id
//  for userSettings) er lik deres egen uid. Klientspørringene filtrerer allerede
//  på where('userId','==',uid); disse reglene HÅNDHEVER det på serversiden, så
//  en annen innlogget konto ikke kan lese eller endre andres data.
//
//  VIKTIG: denne fila må holdes i synk med det som er PUBLISERT i Firebase
//  Console (eller deploy med:  firebase deploy --only firestore:rules).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Utgifter og kjøreturer. Eierskap avgjøres av userId-feltet.
    match /receipts/{id} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create:       if isOwner(request.resource.data.userId);
      // Ved endring må dokumentet forbli eid av samme bruker (kan ikke gis bort).
      allow update:       if isOwner(resource.data.userId)
                          && isOwner(request.resource.data.userId);
    }

    // Inntekter. Samme eierskapsmodell som receipts.
    match /income/{id} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create:       if isOwner(request.resource.data.userId);
      allow update:       if isOwner(resource.data.userId)
                          && isOwner(request.resource.data.userId);
    }

    // Brukerinnstillinger: ett dokument per bruker, med uid som dokument-id.
    match /userSettings/{uid} {
      allow read, write: if isOwner(uid);
    }
  }
}
